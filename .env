VITE_BC4_DATA=api
# Le navigateur attaque /api/* en same-origin, Vite proxyfie vers l'upstream.
# Évite CORS et les problèmes de forward SSH (seul le port front suffit).
# Toute modif de VITE_BC4_API_BASE impose un redémarrage/rebuild Vite.
VITE_BC4_API_BASE=/api
VITE_BC4_API_UPSTREAM=https://permalink-dependent-spell-outsourcing.trycloudflare.com/api
# B2 : plus d'acteur de dev — l'identité vient du login réel (JWT).
