  "/projects/{project_id}/kpi/catalog": {
    "get": {
      "tags": [
        "kpi-project"
      ],
      "summary": "Kpi Catalog",
      "description": "Catalogue v2 : 194 canoniques + 14 alias (208 input xlsx).\n\nSi ``service_type[]`` est fourni, les KPI hors scope sont marqu\u00e9s\n``NOT_APPLICABLE`` dans l'arbre (jamais filtr\u00e9s silencieusement).",
      "operationId": "kpi_catalog_projects__project_id__kpi_catalog_get",
      "security": [
        {
          "HTTPBearer": []
        }
      ],
      "parameters": [
        {
          "name": "project_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "title": "Project Id"
          }
        },
        {
          "name": "service_type",
          "in": "query",
          "required": false,
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "Service Type"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Successful Response",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectKpiCatalog"
              }
            }
          }
        },
        "422": {
          "description": "Validation Error",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HTTPValidationError"
              }
            }
          }
        }
      }
    }
  },
