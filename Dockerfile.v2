# Image de production BC4. Le navigateur utilise /api en même origine ;
# le serveur Nitro relaie vers BC4_API_UPSTREAM sur le réseau Docker.
FROM oven/bun:1
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
ENV VITE_BC4_DATA=api
ENV VITE_BC4_API_BASE=/api
ENV VITE_BC4_API_UPSTREAM=http://api:8000
ENV BC4_API_UPSTREAM=http://api:8000
ENV NITRO_PRESET=node-server
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=5173
RUN bun run build
ARG VCS_REF=unknown
ARG APP_VERSION=1.105.7
LABEL org.opencontainers.image.revision=$VCS_REF
LABEL org.opencontainers.image.version=$APP_VERSION
LABEL org.opencontainers.image.title="BC4 Front — production Nitro runtime"
LABEL org.opencontainers.image.description="Production runtime with same-origin API proxy; no Vite dependency optimization at startup."
CMD ["bun", ".output/server/index.mjs"]
