# 1.83.1 — Image avec warm-up Vite au démarrage (élimine le cold-start
# "Loading KPI catalogue…" vu par l'utilisateur après recréation du container).
# NE REMPLACE PAS bc4-front-rf:1.71.2 : tag bc4-front-v2:1.83.1.
FROM oven/bun:1
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
ENV VITE_BC4_DATA=api
ENV VITE_BC4_API_UPSTREAM=http://api:8000
RUN bun run build
LABEL org.opencontainers.image.revision="c1e2269"
LABEL org.opencontainers.image.version="1.97.0"
LABEL org.opencontainers.image.title="BC4 Front — Phase 2 Charts (synchronized cursor + Events Ribbon)"
LABEL org.opencontainers.image.description="MetricGraphCard syncId Recharts (cursor synchronisé entre cartes du grid) + MetricsEventsRibbon au-dessus du grid (task/ho/rlf/rrc markers). CSS matrix 1/2/3 cols."
RUN chmod +x /app/docker-warmup.sh
# Warm-up en arrière-plan + vite dev au premier plan.
# Le warm-up attend que vite réponde avant de taper les routes.
CMD ["sh", "-c", "/app/docker-warmup.sh > /tmp/warmup.log 2>&1 & exec bun run dev --host 0.0.0.0 --port 5173"]
